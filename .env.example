# Copie para .env e preencha somente valores apropriados ao ambiente local.
# Nunca versione .env nem exponha chaves em variáveis VITE_*.

SUPABASE_URL=
SUPABASE_SECRET_KEY=

CDN_SECRET_KEY=local-development-secret
CDN_AUTH_MODE=local
CDN_CONTROL_TOKEN=
CDN_VIEWER_SESSION_SECRET=
CDN_OPERATOR_ACCOUNTS=
CDN_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Opcional: diretório local montado no Compose como dataset somente leitura.
CDN_DATASET_DIR=./data/datasets/youtube_clipped_videos
