@startuml c4-context
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title CDN Security Simulator — C4 nível 1: contexto do sistema

LAYOUT_LEFT_RIGHT()

Person(operator, "Operador / equipe", "Configura a simulação, observa a topologia e investiga evidências.")
System(cdnSecurity, "CDN Security Simulator", "Simula entrega distribuída de vídeo, watermarking forense, detecção de vazamentos e blacklist propagada.")
System_Ext(videoPlatform, "Plataformas externas simuladas", "Recebem cópias de chunks para representar exposição/pirataria.")
System_Ext(osm, "OpenStreetMap", "Fornece os tiles cartográficos exibidos no console.")

Rel(operator, cdnSecurity, "Configura, observa e testa", "HTTPS/HTTP + JSON")
Rel(cdnSecurity, videoPlatform, "Consulta vazamentos simulados", "Dados em memória")
Rel(cdnSecurity, osm, "Carrega mapa", "HTTPS")

SHOW_LEGEND()
@enduml
